# Firebase web config (safe to expose; these identify the project, they do not
# grant access -- security rules and the API routes do that).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account JSON for the Admin SDK, as raw JSON on one line or base64.
# Firebase console -> Project settings -> Service accounts -> Generate key.
# Keep this secret. In Vercel, add it as an Environment Variable.
FIREBASE_SERVICE_ACCOUNT=
